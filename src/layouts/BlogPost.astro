---
import { Image } from "astro:assets";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";

type Props = {
  title: string;
  description: string;
  pubDate?: Date;
  updatedDate?: Date;
  heroImage?: any;
  tags?: string[];
};

const { title, description, pubDate, updatedDate, heroImage, tags } =
  Astro.props;
---

<html lang="sv">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-D4HEFBCNSV"
    ></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-D4HEFBCNSV");
    </script>

    <BaseHead title={title} description={description} />
    <style>
      main {
        width: calc(100% - 2em);
        max-width: 100%;
        margin: 0;
      }

      .hero-image {
        width: 100%;
        padding-top: 2rem;
      }

      .hero-image img {
        display: block;
        margin: 0 auto;
        border-radius: 12px;
        box-shadow: var(--box-shadow);
      }

      .prose {
        width: 720px;
        max-width: calc(100% - 2em);
        margin: auto;
        padding: 1em;
        color: rgb(var(--gray-dark));
      }

      .title {
        margin-bottom: 1em;
        padding: 1em 0;
        text-align: center;
        line-height: 1;
      }

      .title h1 {
        margin: 0 0 0.5em 0;
      }

      .date {
        margin-bottom: 0.5em;
        color: rgb(var(--gray));
      }

      .last-updated-on {
        font-style: italic;
      }

      .post-tags {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.5rem;
        margin-top: 1rem;
      }

      .tag {
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--brand);
        background: rgba(54, 117, 136, 0.08);
        padding: 0.25rem 0.65rem;
        border-radius: 999px;
        text-decoration: none;
        transition: background 0.2s ease;
      }

      .tag:hover {
        background: rgba(54, 117, 136, 0.18);
      }

      @media (max-width: 720px) {
        .prose {
          width: 100%;
          max-width: 100%;
          padding: 0.75em;
        }

        .hero-image img {
          border-radius: 0;
        }
      }
    </style>
  </head>

  <body>
    <Header />
    <main>
      <article>
        <div class="hero-image">
          {
            heroImage && (
              <Image
                width={1020}
                height={510}
                src={heroImage}
                alt=""
                style="width: 100%; height: auto; max-height: 400px; object-fit: cover;"
              />
            )
          }
        </div>
        <div class="prose">
          <div class="title">
            {
              pubDate && (
                <div class="date">
                  <FormattedDate date={pubDate} />
                  {updatedDate && (
                    <div class="last-updated-on">
                      Last updated on <FormattedDate date={updatedDate} />
                    </div>
                  )}
                </div>
              )
            }
            <h1>{title}</h1>
            {
              tags && tags.length > 0 && (
                <div class="post-tags">
                  {tags.map((tag) => (
                    <a href={`/tags/${tag}/`} class="tag">
                      #{tag}
                    </a>
                  ))}
                </div>
              )
            }
            <hr />
          </div>
          <slot />
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
