---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { Image } from "astro:assets";

type Props = Omit<CollectionEntry<"blog">["data"], "pubDate"> & {
  id?: string;
  pubDate?: Date;
};

const { title, description, pubDate, updatedDate, heroImage, tags, id } =
  Astro.props;

// Hämta alla inlägg för att kunna filtrera ut relaterade
const allPosts = await getCollection("blog");

// Hitta relaterade inlägg baserat på matchande taggar (exkludera nuvarande inlägg)
const relatedPosts = allPosts
  .filter(
    (post) =>
      post.id !== id &&
      post.data.tags &&
      tags &&
      post.data.tags.some((t) => tags.includes(t)),
  )
  .slice(0, 3); // Visa max 3 relaterade inlägg
---

<!doctype html>
<html lang="sv">
  <head>
    <BaseHead title={title} description={description} />
  </head>
  <body>
    <div id="reading-progress" class="reading-progress"></div>
    <Header />
    <main>
      <article class="article-container">
        {
          heroImage && (
            <div class="hero-image">
              <Image
                src={heroImage}
                alt=""
                width={1200}
                height={600}
                class="article-hero-img"
              />
            </div>
          )
        }
        <div class="prose">
          <div class="title">
            {
              pubDate && (
                <div class="date">
                  <FormattedDate date={pubDate} />
                  {updatedDate && (
                    <div class="last-updated-on">
                      Uppdaterad: <FormattedDate date={updatedDate} />
                    </div>
                  )}
                </div>
              )
            }
            <h1>{title}</h1>
            {
              tags && tags.length > 0 && (
                <div class="tag-list">
                  {tags.map((tag) => (
                    <span class="tag">#{tag}</span>
                  ))}
                </div>
              )
            }
            <hr />
          </div>

          <!-- Här kommer själva texten från markdown-filen -->
          <slot />
        </div>

        {/* RELATERADE INLÄGG LÄNGST NER */}
        {
          relatedPosts.length > 0 && (
            <section class="related-section">
              <h3>Fler anteckningar på liknande spår</h3>
              <div class="related-grid">
                {relatedPosts.map((post, i) => (
                  <a
                    href={`/blog/${post.id}/`}
                    class="related-card reveal"
                    style={`--reveal-delay: ${i * 80}ms`}
                  >
                    {post.data.heroImage && (
                      <div class="related-img-wrap">
                        <Image
                          src={post.data.heroImage}
                          alt={post.data.title}
                          width={400}
                          height={200}
                          class="related-img"
                        />
                      </div>
                    )}
                    <div class="related-content">
                      <span class="related-date">
                        <FormattedDate date={post.data.pubDate} />
                      </span>
                      <h4>{post.data.title}</h4>
                    </div>
                  </a>
                ))}
              </div>
            </section>
          )
        }
      </article>
    </main>
    <Footer />
  </body>
</html>

<script>
  let cleanupReadingProgress: (() => void) | undefined;

  function initReadingProgress() {
    cleanupReadingProgress?.();
    const bar = document.getElementById("reading-progress");
    const article = document.querySelector(".article-container");
    if (!bar || !article) return;

    const update = () => {
      const rect = article.getBoundingClientRect();
      const total = article.scrollHeight - window.innerHeight;
      const pct = total > 0 ? (Math.min(Math.max(-rect.top, 0), total) / total) * 100 : 0;
      bar.style.width = pct + "%";
    };

    update();
    document.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    cleanupReadingProgress = () => {
      document.removeEventListener("scroll", update);
      window.removeEventListener("resize", update);
    };
  }

  document.addEventListener("astro:page-load", initReadingProgress);
</script>

<style>
  .reading-progress {
    position: fixed;
    top: var(--header-height, 70px);
    left: 0;
    height: 3px;
    width: 0%;
    background: var(--accent-warm);
    z-index: 40;
  }

  .article-container {
    max-width: 800px;
    margin: 0 auto;
    padding: 2rem 1rem 4rem 1rem;
  }

  .hero-image {
    width: 100%;
    margin-bottom: 2rem;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--border-soft);
  }

  .article-hero-img {
    width: 100%;
    height: auto;
    max-height: 400px;
    object-fit: cover;
    display: block;
  }

  .title {
    margin-bottom: 2rem;
  }

  .date {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 1rem;
  }

  .tag {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--brand, #367588);
    background: rgba(54, 117, 136, 0.08);
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
  }

  /* Stil för relaterade inlägg */
  .related-section {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-soft);
  }

  .related-section h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--text-main);
    margin-bottom: 1.5rem;
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
  }

  .related-card {
    background: var(--bg-card);
    border: 1px solid var(--border-soft);
    border-radius: 6px;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .related-card:hover {
    transform: translateY(-2px);
    border-color: var(--accent-warm);
    box-shadow: 0 8px 16px rgba(36, 31, 28, 0.08);
  }

  .related-img-wrap {
    height: 120px;
    overflow: hidden;
  }

  .related-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .related-content {
    padding: 1rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .related-date {
    font-size: 0.7rem;
    color: var(--text-muted);
    margin-bottom: 0.3rem;
  }

  .related-content h4 {
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-main);
    margin: 0;
    line-height: 1.3;
  }
</style>
