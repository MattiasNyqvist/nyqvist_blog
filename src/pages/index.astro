---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const lastPost = posts[0];
---

<!doctype html>
<html lang="sv">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <Hero />

      {
        lastPost ? (
          <section class="latest-post fade-in">
            <span class="post-tag">Senaste inlägget</span>
            <h2>{lastPost.data.title}</h2>
            <p class="post-description">{lastPost.data.description}</p>
            <a href={`/blog/${lastPost.id}/`} class="cta-button">
              Läs inlägget →
            </a>
          </section>
        ) : (
          <p>Inga inlägg hittades ännu.</p>
        )
      }
    </main>
    <Footer />
  </body>
</html>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .fade-in {
    animation: fadeInUp 0.5s ease both;
  }

  /* Latest post card */
  .latest-post {
    background: var(--bg-card);
    border-left: 3px solid var(--brand);
    border-radius: 6px;
    padding: 3rem 3rem 3rem 2.5rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  }

  .latest-post h2 {
    margin: 0 0 1rem 0;
    font-size: 1.5rem;
    font-weight: 400;
    color: #111827;
    line-height: 1.3;
  }

  .post-description {
    color: #5a5a5a;
    font-size: 0.97rem;
    margin-bottom: 2rem;
    line-height: 1.8;
  }

  .cta-button {
    display: inline-block;
    padding: 0.6rem 1.4rem;
    border: 1.5px solid var(--brand);
    border-radius: 3px;
    color: var(--brand);
    font-size: 0.85rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    text-decoration: none;
    transition:
      background 0.2s ease,
      color 0.2s ease;
  }

  .cta-button:hover {
    background: var(--brand);
    color: #ffffff;
    opacity: 1;
  }

  @media (max-width: 720px) {
    .latest-post {
      padding: 1.75rem 1.25rem;
      border-left-width: 2px;
    }

    .cta-button {
      width: 100%;
      text-align: center;
      box-sizing: border-box;
    }
  }
</style>
