---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getCollection } from 'astro:content';

// Här hämtar vi alla inlägg och sorterar dem efter datum
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Vi tar det allra senaste inlägget
const lastPost = posts[0];
---

<!doctype html>
<html lang="sv">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Välkommen till min dev-blogg!</h1>
			
			{lastPost ? (
				<section>
					<h2>Senaste inlägget: {lastPost.data.title}</h2>
					<p>{lastPost.data.description}</p>
					<a href={`/blog/${lastPost.id}/`}>Läs hela inlägget här</a>
				</section>
			) : (
				<p>Inga inlägg hittades ännu.</p>
			)}

			<hr />
			<p>
				Här skriver jag om min resa i Azure och utveckling. 
				Klicka på "Blog" i menyn för att se alla mina tankar.
			</p>
		</main>
		<Footer />
	</body>
</html>
