---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

// Hämta och sortera inlägg
const allPosts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Det nyaste inlägget blir "Hero", resten hamnar i listan
const latestPost = allPosts[0];
const otherPosts = allPosts.slice(1, 7);

// Paginering (samma sidstorlek som /blog/)
const PAGE_SIZE = 6;
const totalPages = Math.ceil(allPosts.length / PAGE_SIZE);

// Extrahera unika taggar för att skapa en tagg-bar
const allTags = [...new Set(allPosts.flatMap((post) => post.data.tags || []))].sort((a, b) =>
  a.localeCompare(b, "sv"),
);
---

<!doctype html>
<html lang="sv">
  <head>
    <BaseHead
      title="Mattias Nyqvist – Utvecklare, ledare och nyfiken"
      description="Ett öppet anteckningsblock från en vetgirig utvecklare."
    />
  </head>
  <body>
    <Header />
    <main>
      <!-- Profilsektion -->
      <section class="profile-section">
        <div class="profile-text">
          <div class="profile-tags">
            <span>UTVECKLARE</span> • <span>LEDARE</span> • <span
              >IT-ERFARENHET</span
            > • <span>NYFIKENHET</span>
          </div>
          <h1>Mattias Nyqvist</h1>
          <p>
            Ett öppet anteckningsblock från en vetgirig utvecklare. Här landar
            det jag håller på med, testar och tänker på – ibland djupdykningar i
            teknik, ibland något helt annat.
          </p>
        </div>
        <div class="profile-avatar-container">
          <!-- Byt ut src mot din faktiska bildfil i mappen public -->
          <Image
            src="/images/mattias.jpg"
            alt="Mattias Nyqvist"
            width={160}
            height={160}
            class="profile-avatar"
          />
        </div>
      </section>

      <!-- TAGG-BAR: Gör det levande och lätt att navigera -->
      {
        allTags.length > 0 && (
          <section class="tag-bar-section">
            <span class="tag-bar-label">Utforska ämnen:</span>
            <div class="tag-bar-list">
              {allTags.map((tag) => (
                <a href={`/tags/${tag.toLowerCase()}/`} class="tag-pill">
                  #{tag}
                </a>
              ))}
            </div>
          </section>
        )
      }

      <!-- HUVUDINLÄGG: HERO-KORT (Det senaste inlägget) -->
      {
        latestPost && (
          <section class="hero-post-section">
            <div class="section-header">
              <div>
                <span class="kicker">Utvalt</span>
                <h2>Senaste inlägget</h2>
              </div>
            </div>
            <article class="hero-card reveal">
              <a href={`/blog/${latestPost.id}/`} class="hero-link">
                <div class="hero-image-wrapper">
                  {latestPost.data.heroImage ? (
                    <Image
                      src={latestPost.data.heroImage}
                      alt={latestPost.data.title}
                      width={1200}
                      height={600}
                      class="hero-img"
                    />
                  ) : (
                    <div class="post-img-placeholder" />
                  )}
                  <div class="date-overlay">
                    <FormattedDate date={latestPost.data.pubDate} />
                  </div>
                </div>
                <div class="hero-content">
                  <h3 class="hero-title">{latestPost.data.title}</h3>
                  <p class="hero-description">{latestPost.data.description}</p>
                  {latestPost.data.tags && latestPost.data.tags.length > 0 && (
                    <div class="tag-list">
                      {latestPost.data.tags.map((tag) => (
                        <span class="tag">#{tag}</span>
                      ))}
                    </div>
                  )}
                </div>
              </a>
            </article>
          </section>
        )
      }

      <!-- FLER INLÄGG: 3-KOLUMNSRUTIN -->
      {
        otherPosts.length > 0 && (
          <section class="older-posts-section">
            <div class="section-header">
              <div>
                <span class="kicker">Inlägg</span>
                <h2>Fler inlägg</h2>
              </div>
            </div>

            <ul class="post-grid">
              {otherPosts.map((post, i) => (
                <li class="post-item reveal" style={`--reveal-delay: ${(i % 3) * 80}ms`}>
                  <a href={`/blog/${post.id}/`} class="post-link">
                    <div class="post-image">
                      {post.data.heroImage ? (
                        <Image
                          src={post.data.heroImage}
                          alt={post.data.title}
                          width={600}
                          height={300}
                          class="post-img"
                        />
                      ) : (
                        <div class="post-img-placeholder" />
                      )}
                      <div class="date-overlay">
                        <FormattedDate date={post.data.pubDate} />
                      </div>
                    </div>
                    <div class="post-body">
                      <h3 class="post-title">{post.data.title}</h3>
                      <p class="post-description">{post.data.description}</p>
                      {post.data.tags && post.data.tags.length > 0 && (
                        <div class="tag-list">
                          {post.data.tags.map((tag) => (
                            <span class="tag">#{tag}</span>
                          ))}
                        </div>
                      )}
                    </div>
                  </a>
                </li>
              ))}
            </ul>

            {totalPages > 1 && (
              <div class="pagination">
                <span />
                <span class="pagination-info">Sida 1 av {totalPages}</span>
                <a href="/blog/2/" class="pagination-next">
                  Nästa sida →
                </a>
              </div>
            )}
          </section>
        )
      }
    </main>
    <Footer />
  </body>
</html>

<style>
  /* Grundlayout och profildel */
  .profile-section {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3rem;
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-soft);
  }

  .profile-tags {
    font-size: 0.95rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-bottom: 1.1rem;
    font-weight: 600;
  }

  .profile-tags span {
    color: var(--accent-warm);
    font-weight: 700;
  }

  .profile-text h1 {
    font-size: clamp(2rem, 1.5rem + 2.2vw, 2.8rem);
    font-weight: 500;
    color: var(--text-main);
    margin: 0 0 1rem 0;
  }

  .profile-text p {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0;
    max-width: 600px;
  }

  .profile-avatar-container {
    flex-shrink: 0;
    position: relative;
  }

  .profile-avatar-container::before {
    content: "";
    position: absolute;
    inset: -10px -16px auto auto;
    width: 160px;
    height: 160px;
    border-radius: 50%;
    background: var(--accent-warm);
    opacity: 0.18;
    transform: rotate(-6deg);
    z-index: 0;
  }

  .profile-avatar {
    position: relative;
    z-index: 1;
    width: 160px;
    height: 160px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 10px 25px -5px rgba(36, 31, 28, 0.15);
  }

  /* Tagg-bar */
  .tag-bar-section {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-bottom: 2rem;
    margin-bottom: 3rem;
    border-bottom: 1px solid var(--border-soft);
    flex-wrap: wrap;
  }

  .tag-bar-label {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .tag-bar-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag-pill {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--brand, #367588);
    background: var(--gray-light);
    border: 1px solid var(--border-soft);
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .tag-pill:hover {
    background: var(--accent-warm);
    color: #ffffff;
    border-color: var(--accent-warm);
    transform: translateY(-1px) rotate(-1deg);
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 1.5rem;
  }

  .kicker {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-warm);
    margin-bottom: 0.35rem;
  }

  .section-header h2 {
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--text-main);
    margin: 0;
  }

  /* HERO-KORT */
  .hero-post-section {
    margin-bottom: 3rem;
  }

  .hero-card {
    background: var(--bg-card);
    border: 1px solid var(--border-soft);
    border-radius: 8px;
    overflow: hidden;
    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  .hero-card:hover {
    transform: translateY(-3px);
    border-color: var(--accent-warm);
    box-shadow: 0 12px 24px rgba(36, 31, 28, 0.08);
  }

  .hero-link {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    text-decoration: none;
    color: inherit;
  }

  .hero-image-wrapper {
    width: 100%;
    min-height: 280px;
    overflow: hidden;
    position: relative;
  }

  .date-overlay {
    position: absolute;
    left: 0.9rem;
    bottom: 0.75rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: #ffffff;
    background: rgba(0, 0, 0, 0.55);
    padding: 0.3rem 0.65rem;
    border-radius: 4px;
    letter-spacing: 0.01em;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .hero-card:hover .hero-img {
    transform: scale(1.03);
  }

  .hero-content {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero-title {
    font-family: var(--font-heading);
    font-size: clamp(1.35rem, 1.1rem + 1.1vw, 1.8rem);
    font-weight: 600;
    color: var(--text-main);
    margin: 0.5rem 0 1rem 0;
    line-height: 1.2;
  }

  .hero-description {
    font-size: 1rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0 0 1.5rem 0;
  }

  /* 3-KOLUMNSRUTIN */
  .older-posts-section {
    margin-bottom: 4rem;
  }

  .post-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  .post-item {
    background: var(--bg-card);
    border: 1px solid var(--border-soft);
    border-radius: 6px;
    overflow: hidden;
    transition:
      transform 0.25s ease,
      border-color 0.25s ease,
      box-shadow 0.25s ease;
    padding: 0;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .post-item::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--accent-warm);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }

  .post-item:hover {
    transform: translateY(-3px);
    border-color: var(--border-soft);
    box-shadow: 0 10px 20px -2px rgba(36, 31, 28, 0.08);
  }

  .post-item:hover::before {
    transform: scaleX(1);
  }

  .post-link {
    display: flex;
    flex-direction: column;
    flex: 1;
    text-decoration: none;
    color: inherit;
  }

  .post-image {
    width: 100%;
    height: 140px;
    overflow: hidden;
    position: relative;
  }

  .post-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s ease;
  }

  .post-item:hover .post-img {
    transform: scale(1.04);
  }

  .post-img-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--gray-light) 0%, var(--bg-card) 100%);
  }

  .post-body {
    padding: 1rem 1.25rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .post-title {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-main);
    margin: 0 0 0.5rem 0;
    line-height: 1.3;
  }

  .post-description {
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0 0 0.75rem 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
  }

  .tag {
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--brand, #367588);
    background: rgba(54, 117, 136, 0.08);
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
  }

  /* Paginering */
  .pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-soft);
  }

  .pagination-info {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .pagination-next,
  .pagination-prev {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--brand, #367588);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .pagination-next:hover,
  .pagination-prev:hover {
    opacity: 0.7;
  }

  /* Responsivt */
  @media (max-width: 900px) {
    .profile-section {
      flex-direction: column-reverse;
      text-align: center;
      gap: 1.5rem;
    }
    .profile-text p {
      margin: 0 auto;
    }
    .hero-link {
      grid-template-columns: 1fr;
    }
    .post-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .post-grid {
      grid-template-columns: 1fr;
    }
    .tag-bar-section {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>
