---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Hero from "../components/Hero.astro";
import FormattedDate from "../components/FormattedDate.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const recentPosts = posts.slice(0, 3);
---

<!doctype html>
<html lang="sv">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <Hero />

      {
        recentPosts.length > 0 ? (
          <div class="recent-posts fade-in">
            <div class="section-header">
              <span class="section-label">Senaste inläggen</span>
              <a href="/blog/" class="all-posts-link">
                Visa alla →
              </a>
            </div>

            <div class="post-list">
              {recentPosts.map((post) => (
                <div class="post-card">
                  <div class="post-card-content">
                    <div class="post-meta">
                      <FormattedDate date={post.data.pubDate} />
                    </div>
                    <h2>{post.data.title}</h2>
                    <p class="post-description">{post.data.description}</p>
                    {post.data.tags && post.data.tags.length > 0 && (
                      <div class="tag-list">
                        {post.data.tags.map((tag) => (
                          <a href={`/tags/${tag}/`} class="tag">
                            #{tag}
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                  <div class="post-card-footer">
                    <a href={`/blog/${post.id}/`} class="read-more">
                      Läs inlägget →
                    </a>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ) : (
          <p>Inga inlägg hittades ännu.</p>
        )
      }
    </main>
    <Footer />
  </body>
</html>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .fade-in {
    animation: fadeInUp 0.5s ease both;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .section-label {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand);
  }

  .all-posts-link {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--brand);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .all-posts-link:hover {
    opacity: 0.7;
  }

  .post-list {
    display: flex;
    flex-direction: column;
  }

  .post-card {
    background: var(--bg-card);
    border-left: 3px solid var(--brand);
    border-radius: 6px;
    padding: 2rem 2.25rem;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.08);
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    transition: box-shadow 0.2s ease;
    margin-bottom: 1.25rem;
  }

  .post-card:last-child {
    margin-bottom: 0;
  }

  .post-card:hover {
    box-shadow: 0 8px 16px -2px rgba(0, 0, 0, 0.12);
  }

  .post-card-content {
    flex: 1;
    min-width: 0;
  }

  .post-meta {
    font-size: 0.75rem;
    color: #6b7280;
    margin-bottom: 0.4rem;
  }

  .post-card h2 {
    margin: 0 0 0.6rem 0;
    font-size: 1.2rem;
    font-weight: 500;
    color: #111827;
    line-height: 1.3;
  }

  .post-description {
    color: #374151;
    font-size: 0.92rem;
    margin: 0 0 0.9rem 0;
    line-height: 1.7;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--brand);
    background: rgba(54, 117, 136, 0.08);
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.2s ease;
  }

  .tag:hover {
    background: rgba(54, 117, 136, 0.18);
    opacity: 1;
  }

  .post-card-footer {
    flex-shrink: 0;
  }

  .read-more {
    display: inline-block;
    padding: 0.6rem 1.25rem;
    background: var(--brand);
    color: #ffffff;
    border-radius: 3px;
    font-size: 0.82rem;
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }

  .read-more:hover {
    opacity: 0.85;
  }

  @media (max-width: 720px) {
    .post-card {
      flex-direction: column;
      align-items: flex-start;
      padding: 1.25rem;
      gap: 1rem;
    }

    .read-more {
      width: 100%;
      text-align: center;
      box-sizing: border-box;
    }
  }
</style>
