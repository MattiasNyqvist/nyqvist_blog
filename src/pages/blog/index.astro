---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="sv">
  <head>
    <BaseHead title="Inlägg" description="Alla inlägg på Nyqvist Blogg" />
  </head>
  <body>
    <Header />
    <main>
      <div class="blog-header">
        <h1>Inlägg</h1>
        <a href="/tags/" class="all-tags-link">Bläddra bland taggar →</a>
      </div>

      <ul class="post-list">
        {
          posts.map((post) => (
            <li class="post-item">
              <a href={`/blog/${post.id}/`} class="post-link">
                <div class="post-meta">
                  <FormattedDate date={post.data.pubDate} />
                </div>
                <h2 class="post-title">{post.data.title}</h2>
                <p class="post-description">{post.data.description}</p>
                {post.data.tags && post.data.tags.length > 0 && (
                  <div class="tag-list">
                    {post.data.tags.map((tag) => (
                      <span class="tag">#{tag}</span>
                    ))}
                  </div>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </main>
    <Footer />
  </body>
</html>

<style>
  .blog-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e5e7eb;
  }

  .blog-header h1 {
    margin: 0;
    font-size: 2rem;
    font-weight: 300;
    color: #111827;
  }

  .all-tags-link {
    font-size: 0.85rem;
    color: var(--brand);
    text-decoration: none;
    font-weight: 500;
  }

  .all-tags-link:hover {
    opacity: 0.7;
  }

  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .post-item {
    border-bottom: 1px solid #f0f0f0;
    padding: 0;
  }

  .post-item:last-child {
    border-bottom: none;
  }

  .post-link {
    display: block;
    padding: 1.75rem 0;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.2s ease;
  }

  .post-link:hover {
    opacity: 0.8;
  }

  .post-meta {
    font-size: 0.78rem;
    color: #6b7280;
    margin-bottom: 0.5rem;
    font-weight: 400;
  }

  .post-title {
    font-size: 1.25rem;
    font-weight: 500;
    color: #111827;
    margin: 0 0 0.6rem 0;
    line-height: 1.3;
  }

  .post-description {
    font-size: 0.95rem;
    color: #374151;
    line-height: 1.7;
    margin: 0 0 1rem 0;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--brand);
    background: rgba(54, 117, 136, 0.08);
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
  }
</style>
