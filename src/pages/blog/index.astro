---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const PAGE_SIZE = 6;
const currentPage = 1;
const totalPages = Math.ceil(posts.length / PAGE_SIZE);
const pagePosts = posts.slice(0, PAGE_SIZE);
---

<!doctype html>
<html lang="sv">
  <head>
    <BaseHead title="Inlägg" description="Alla inlägg på Nyqvist Blogg" />
  </head>
  <body>
    <Header />
    <main>
      <div class="blog-header">
        <h1>Inlägg</h1>
        <a href="/tags/" class="all-tags-link">Bläddra bland taggar →</a>
      </div>

      <ul class="post-grid">
        {
          pagePosts.map((post) => (
            <li class="post-item">
              <a href={`/blog/${post.id}/`} class="post-link">
                <div class="post-image">
                  {post.data.heroImage ? (
                    <Image
                      src={post.data.heroImage}
                      alt={post.data.title}
                      width={600}
                      height={300}
                      class="post-img"
                    />
                  ) : (
                    <div class="post-img-placeholder" />
                  )}
                </div>
                <div class="post-body">
                  <div class="post-meta">
                    <FormattedDate date={post.data.pubDate} />
                  </div>
                  <h2 class="post-title">{post.data.title}</h2>
                  <p class="post-description">{post.data.description}</p>
                  {post.data.tags && post.data.tags.length > 0 && (
                    <div class="tag-list">
                      {post.data.tags.map((tag) => (
                        <span class="tag">#{tag}</span>
                      ))}
                    </div>
                  )}
                </div>
              </a>
            </li>
          ))
        }
      </ul>

      {
        totalPages > 1 && (
          <div class="pagination">
            <span />
            <span class="pagination-info">
              Sida {currentPage} av {totalPages}
            </span>
            <a href="/blog/2/" class="pagination-next">
              Nästa sida →
            </a>
          </div>
        )
      }
    </main>
    <Footer />
  </body>
</html>

<style>
  .blog-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e5e7eb;
  }

  .blog-header h1 {
    margin: 0;
    font-size: 2rem;
    font-weight: 300;
    color: #111827;
  }

  .all-tags-link {
    font-size: 0.85rem;
    color: var(--brand);
    text-decoration: none;
    font-weight: 500;
  }

  .all-tags-link:hover {
    opacity: 0.7;
  }

  .post-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .post-item {
    background: #ffffff;
    border-left: 3px solid var(--brand);
    border-radius: 6px;
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.08);
    overflow: hidden;
    transition: box-shadow 0.2s ease;
    padding: 0;
    border-bottom: none;
    display: flex;
    flex-direction: column;
  }

  .post-item:hover {
    box-shadow: 0 8px 16px -2px rgba(0, 0, 0, 0.12);
  }

  .post-link {
    display: flex;
    flex-direction: column;
    flex: 1;
    text-decoration: none;
    color: inherit;
  }

  .post-image {
    width: 100%;
    height: 180px;
    overflow: hidden;
    flex-shrink: 0;
  }

  .post-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .post-img-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #e5e7eb 0%, #f3f4f6 100%);
  }

  .post-item:hover .post-img {
    transform: scale(1.02);
  }

  .post-body {
    padding: 1.25rem 1.5rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .post-meta {
    font-size: 0.75rem;
    color: #6b7280;
    margin-bottom: 0.4rem;
    font-weight: 400;
  }

  .post-title {
    font-size: 1.1rem;
    font-weight: 500;
    color: #111827;
    margin: 0 0 0.5rem 0;
    line-height: 1.3;
  }

  .post-description {
    font-size: 0.9rem;
    color: #374151;
    line-height: 1.6;
    margin: 0 0 1rem 0;
    flex: 1;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
  }

  .tag {
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--brand);
    background: rgba(54, 117, 136, 0.08);
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
  }

  /* Paginering */
  .pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid #e5e7eb;
  }

  .pagination-info {
    font-size: 0.85rem;
    color: #6b7280;
  }

  .pagination-next,
  .pagination-prev {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--brand);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .pagination-next:hover,
  .pagination-prev:hover {
    opacity: 0.7;
  }

  @media (max-width: 720px) {
    .post-grid {
      grid-template-columns: 1fr;
    }

    .post-image {
      height: 160px;
    }

    .post-body {
      padding: 1rem 1.25rem;
    }
  }
</style>
