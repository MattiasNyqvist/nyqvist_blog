---
import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );
  const PAGE_SIZE = 6;
  const totalPages = Math.ceil(posts.length / PAGE_SIZE);

  return Array.from({ length: totalPages - 1 }, (_, i) => {
    const page = i + 2;
    return {
      params: { page: String(page) },
      props: {
        pagePosts: posts.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE),
        currentPage: page,
        totalPages,
      },
    };
  });
}

const { pagePosts, currentPage, totalPages } = Astro.props;
---

<!doctype html>
<html lang="sv">
  <head>
    <BaseHead
      title={`Inlägg – sida ${currentPage}`}
      description="Alla inlägg på Nyqvist Blogg"
    />
  </head>
  <body>
    <Header />
    <main>
      <div class="blog-header">
        <h1>Inlägg</h1>
      </div>

      <ul class="post-grid">
        {
          pagePosts.map((post, i) => (
            <li class="post-item reveal" style={`--reveal-delay: ${(i % 3) * 80}ms`}>
              <a href={`/blog/${post.id}/`} class="post-link">
                <div class="post-image">
                  {post.data.heroImage ? (
                    <Image
                      src={post.data.heroImage}
                      alt={post.data.title}
                      width={600}
                      height={300}
                      class="post-img"
                    />
                  ) : (
                    <div class="post-img-placeholder" />
                  )}
                  <div class="date-overlay">
                    <FormattedDate date={post.data.pubDate} />
                  </div>
                </div>
                <div class="post-body">
                  <h2 class="post-title">{post.data.title}</h2>
                  <p class="post-description">{post.data.description}</p>
                  {post.data.tags && post.data.tags.length > 0 && (
                    <div class="tag-list">
                      {post.data.tags.map((tag) => (
                        <span class="tag">#{tag}</span>
                      ))}
                    </div>
                  )}
                </div>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="pagination">
        <a
          href={currentPage === 2 ? "/blog/" : `/blog/${currentPage - 1}/`}
          class="pagination-prev"
        >
          ← Föregående sida
        </a>
        <span class="pagination-info">Sida {currentPage} av {totalPages}</span>
        {
          currentPage < totalPages && (
            <a href={`/blog/${currentPage + 1}/`} class="pagination-next">
              Nästa sida →
            </a>
          )
        }
        {currentPage >= totalPages && <span />}
      </div>
    </main>
    <Footer />
  </body>
</html>

<style>
  .blog-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-soft);
  }

  .blog-header h1 {
    margin: 0;
    font-size: clamp(1.6rem, 1.3rem + 1.5vw, 2.2rem);
    font-weight: 700;
    color: var(--text-main);
  }

  .post-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    align-items: start;
  }

  .post-item {
    background: var(--bg-card);
    border: 1px solid var(--border-soft);
    border-radius: 6px;
    overflow: hidden;
    transition:
      transform 0.25s ease,
      box-shadow 0.2s ease;
    padding: 0;
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .post-item::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--accent-warm);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }

  .post-item:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 16px -2px rgba(36, 31, 28, 0.1);
  }

  .post-item:hover::before {
    transform: scaleX(1);
  }

  .post-link {
    display: flex;
    flex-direction: column;
    flex: 1;
    text-decoration: none;
    color: inherit;
  }

  .post-image {
    width: 100%;
    height: 150px;
    overflow: hidden;
    flex-shrink: 0;
    position: relative;
  }

  .date-overlay {
    position: absolute;
    left: 0.9rem;
    bottom: 0.7rem;
    font-size: 0.85rem;
    font-weight: 500;
    color: #ffffff;
    background: rgba(0, 0, 0, 0.55);
    padding: 0.3rem 0.65rem;
    border-radius: 4px;
    letter-spacing: 0.01em;
  }

  .post-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .post-img-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--gray-light) 0%, var(--bg-card) 100%);
  }

  .post-item:hover .post-img {
    transform: scale(1.02);
  }

  .post-body {
    padding: 1rem 1.5rem;
    flex: 1;
    display: flex;
    flex-direction: column;
  }


  .post-title {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text-main);
    margin: 0 0 0.5rem 0;
    line-height: 1.3;
  }

  .post-description {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0 0 0.75rem 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
  }

  .tag {
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--brand);
    background: rgba(54, 117, 136, 0.08);
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
  }

  .pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-soft);
  }

  .pagination-info {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .pagination-prev,
  .pagination-next {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--brand);
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .pagination-prev:hover,
  .pagination-next:hover {
    opacity: 0.7;
  }

  @media (max-width: 720px) {
    .post-grid {
      grid-template-columns: 1fr;
    }

    .post-image {
      height: 160px;
    }

    .post-body {
      padding: 1rem 1.25rem;
    }
  }
</style>
